{
  "name": "studiodumbar/hyperkavkaz",
  "description": "hyperkavkaz website (Kirby 5)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "^5.6",
    "pechente/kirby-admin-bar": "^2.3",
    "mzur/kirby-uniform": "^5.7",
    "sylvainjule/matomo": "^2.1",
    "getkirby/staticache": "^2.1",
    "medienbaecker/kirby-tiptap": "^1.3",
    "moinframe/kirby-loop": "^1.2",
    "bnomei/kirby3-htmlhead": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ],
    "mcp": "kirby-mcp install"
  },
  "require-dev": {
    "bnomei/kirby-mcp": "^1.15"
  }
}
